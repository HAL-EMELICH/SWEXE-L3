<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<h1>プロフィール一覧</h1>

<% @profiles.each do |profile| %>
  <% if profile.image.attached? %>
    <%= image_tag profile.image %>
  <% else %>
    <p>画像はありません</p>
  <% end %>
  
  <p><%= link_to profile.name, profile %></p>
  <%= profile.detail %>
  <br>
  
  <%= link_to '表示', profile_path(profile) %>
  
  <%= link_to '編集', edit_profile_path(profile) %>  
  
  <%= link_to '削除', @profile, method: :delete, data: { confirm: '本当に削除しますか？' } %>
  
  <br>
  <br>
<% end %>

 <p><%= link_to '新規追加', '/profiles/new' %></p>